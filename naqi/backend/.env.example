# Production must set both keys. NAQI_DEV_MODE is for an explicitly local-only run.
NAQI_API_KEY=replace-with-a-long-random-public-api-key
NAQI_ADMIN_API_KEY=replace-with-a-different-long-random-admin-key
NAQI_DEV_MODE=0

# Optional legacy all-in-one runner. Leave empty when using the typed asset API.
NAQI_PIPELINE_SCRIPT=
# Current monorepo deployment may point this at /opt/naqi/naqi/scripts;
# a standalone deployment should point at an installed pipeline-tools package.
NAQI_PIPELINE_TOOLS_DIR=/opt/naqi/pipeline-tools
SKINTOKENS_HOME=/opt/SkinTokens
GVHMR_HOME=/opt/GVHMR
BLENDER_BIN=/usr/bin/blender
NAQI_GVHMR_RENDER_PREVIEW=0
# Development default is backend/data; production should use a repository-external path.
NAQI_DATA_ROOT=/var/lib/naqi-backend

NAQI_PUBLIC_HOST=127.0.0.1
NAQI_PUBLIC_PORT=18080
NAQI_ADMIN_HOST=127.0.0.1
NAQI_ADMIN_PORT=18081
NAQI_MAX_UPLOAD_BYTES=2147483648
NAQI_FPS_MIN=1
NAQI_FPS_MAX=120
NAQI_WORKERS=1
NAQI_BASH_BINARY=bash
# Empty disables browser CORS. Use an explicit comma-separated allowlist.
NAQI_CORS_ORIGINS=http://localhost:3000
